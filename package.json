{
  "name": "mcp-file-server",
  "version": "1.0.0",
  "description": "Sandboxed MCP file server (stdio + Streamable HTTP)",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/httpServer.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/httpServer.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs mcp-file-server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  }
}
